{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated user profile with role and Pakistani business metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["customer", "freelancer", "admin"] },
        "businessName": { "type": "string", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 40 },
        "city": { "type": "string", "maxLength": 80 },
        "preferredLang": { "type": "string", "enum": ["en", "ur"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "preferredLang", "createdAt", "updatedAt"]
    },
    "Service": {
      "title": "Service",
      "description": "Agency digital service package with PKR pricing and commission rate",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "category": { "type": "string", "enum": ["social_media", "video_editing", "logo_branding", "web_dev"] },
        "title": { "type": "string", "minLength": 2, "maxLength": 120 },
        "titleUr": { "type": "string", "minLength": 2, "maxLength": 140 },
        "description": { "type": "string", "minLength": 10, "maxLength": 1200 },
        "descriptionUr": { "type": "string", "minLength": 2, "maxLength": 1200 },
        "pricePkr": { "type": "number" },
        "turnaroundDays": { "type": "number" },
        "commissionRate": { "type": "number" },
        "deliverables": { "type": "array" },
        "active": { "type": "boolean" },
        "imagePath": { "type": "string", "maxLength": 300 },
        "sortOrder": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "category", "title", "titleUr", "description", "descriptionUr", "pricePkr", "turnaroundDays", "commissionRate", "deliverables", "active", "imagePath", "sortOrder", "updatedAt"]
    },
    "FreelancerProfile": {
      "title": "FreelancerProfile",
      "description": "Approved agency freelancer public profile and skills",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "city": { "type": "string", "minLength": 1, "maxLength": 80 },
        "specialty": { "type": "string", "enum": ["social_media", "video_editing", "logo_branding", "web_dev"] },
        "skills": { "type": "array" },
        "bio": { "type": "string", "minLength": 10, "maxLength": 1200 },
        "portfolioLinks": { "type": "array" },
        "experienceYears": { "type": "number" },
        "availability": { "type": "string", "enum": ["available", "busy"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "completedOrders": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "city", "specialty", "skills", "bio", "portfolioLinks", "experienceYears", "availability", "status", "completedOrders", "createdAt", "updatedAt"]
    },
    "FreelancerPayout": {
      "title": "FreelancerPayout",
      "description": "Private payout bank/wallet details for an approved freelancer",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bankName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "accountTitle": { "type": "string", "minLength": 2, "maxLength": 120 },
        "ibanOrAccount": { "type": "string", "minLength": 4, "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "bankName", "accountTitle", "ibanOrAccount", "updatedAt"]
    },
    "FreelancerApplication": {
      "title": "FreelancerApplication",
      "description": "Freelancer onboarding application awaiting admin review",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 7, "maxLength": 40 },
        "city": { "type": "string", "minLength": 2, "maxLength": 80 },
        "specialty": { "type": "string", "enum": ["social_media", "video_editing", "logo_branding", "web_dev"] },
        "skills": { "type": "array" },
        "bio": { "type": "string", "minLength": 10, "maxLength": 1200 },
        "portfolioLinks": { "type": "array" },
        "experienceYears": { "type": "number" },
        "bankName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "accountTitle": { "type": "string", "minLength": 2, "maxLength": 120 },
        "ibanOrAccount": { "type": "string", "minLength": 4, "maxLength": 64 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "adminNote": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "phone", "city", "specialty", "skills", "bio", "portfolioLinks", "experienceYears", "bankName", "accountTitle", "ibanOrAccount", "status", "adminNote", "createdAt", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer service order with manual payment verification and fulfillment status",
      "type": "object",
      "properties": {
        "orderCode": { "type": "string", "minLength": 4, "maxLength": 32 },
        "customerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "businessName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "serviceId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "serviceTitle": { "type": "string", "minLength": 2, "maxLength": 120 },
        "serviceCategory": { "type": "string", "enum": ["social_media", "video_editing", "logo_branding", "web_dev"] },
        "title": { "type": "string", "minLength": 3, "maxLength": 160 },
        "description": { "type": "string", "minLength": 10, "maxLength": 4000 },
        "deadline": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "pricePkr": { "type": "number" },
        "commissionPercent": { "type": "number" },
        "freelancerEarningPkr": { "type": "number" },
        "agencyProfitPkr": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["awaiting_payment", "payment_submitted", "payment_verified", "in_progress", "submitted_for_review", "revision_requested", "completed", "cancelled"]
        },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "submitted", "verified", "rejected"] },
        "paymentBank": { "type": "string", "maxLength": 120 },
        "paymentReference": { "type": "string", "maxLength": 120 },
        "paymentAmountPkr": { "type": "number" },
        "paymentReceiptFileId": { "type": "string", "maxLength": 128 },
        "paymentReceiptName": { "type": "string", "maxLength": 200 },
        "paymentNotes": { "type": "string", "maxLength": 500 },
        "paymentVerifiedBy": { "type": "string", "maxLength": 128 },
        "paymentRejectionReason": { "type": "string", "maxLength": 500 },
        "assignedFreelancerUid": { "type": "string", "maxLength": 128 },
        "assignedFreelancerName": { "type": "string", "maxLength": 120 },
        "reviewRating": { "type": "number" },
        "reviewComment": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "orderCode", "customerUid", "customerName", "businessName", "serviceId", "serviceTitle", "serviceCategory",
        "title", "description", "deadline", "pricePkr", "commissionPercent", "freelancerEarningPkr", "agencyProfitPkr",
        "status", "paymentStatus", "paymentBank", "paymentReference", "paymentAmountPkr", "paymentReceiptFileId",
        "paymentReceiptName", "paymentNotes", "paymentVerifiedBy", "paymentRejectionReason",
        "assignedFreelancerUid", "assignedFreelancerName", "reviewRating", "reviewComment", "createdAt", "updatedAt"
      ]
    },
    "OrderFile": {
      "title": "OrderFile",
      "description": "Private file metadata linked to an order brief or deliverable",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "ownerRole": { "type": "string", "enum": ["customer", "freelancer", "admin"] },
        "kind": { "type": "string", "enum": ["brief", "deliverable"] },
        "fileId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 240 },
        "mimeType": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sizeBytes": { "type": "number" },
        "note": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "ownerName", "ownerRole", "kind", "fileId", "fileName", "mimeType", "sizeBytes", "note", "createdAt"]
    },
    "OrderTask": {
      "title": "OrderTask",
      "description": "Deliverable checklist task inside an order",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 200 },
        "status": { "type": "string", "enum": ["todo", "in_progress", "done"] },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "status", "createdByUid", "createdAt", "updatedAt"]
    },
    "OrderMessage": {
      "title": "OrderMessage",
      "description": "Message in an order thread between customer, freelancer, and admin",
      "type": "object",
      "properties": {
        "senderUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "senderRole": { "type": "string", "enum": ["customer", "freelancer", "admin"] },
        "body": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderUid", "senderName", "senderRole", "body", "createdAt"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "Freelancer project assignment and earnings ledger record",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orderCode": { "type": "string", "minLength": 4, "maxLength": 32 },
        "orderTitle": { "type": "string", "minLength": 2, "maxLength": 160 },
        "serviceCategory": { "type": "string", "enum": ["social_media", "video_editing", "logo_branding", "web_dev"] },
        "freelancerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "freelancerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "grossPkr": { "type": "number" },
        "commissionPercent": { "type": "number" },
        "commissionPkr": { "type": "number" },
        "netPayoutPkr": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "submitted", "completed", "paid_out"] },
        "payoutReference": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderId", "orderCode", "orderTitle", "serviceCategory", "freelancerUid", "freelancerName", "customerName", "grossPkr", "commissionPercent", "commissionPkr", "netPayoutPkr", "status", "payoutReference", "createdAt", "updatedAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Verified customer review submitted upon order work approval",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "businessName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "serviceCategory": { "type": "string", "enum": ["social_media", "video_editing", "logo_branding", "web_dev"] },
        "serviceTitle": { "type": "string", "minLength": 2, "maxLength": 120 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "minLength": 5, "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderId", "customerUid", "customerName", "businessName", "serviceCategory", "serviceTitle", "rating", "comment", "createdAt"]
    },
    "PaymentSettings": {
      "title": "PaymentSettings",
      "description": "Agency manual bank and mobile wallet transfer instructions",
      "type": "object",
      "properties": {
        "bankName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "accountTitle": { "type": "string", "minLength": 2, "maxLength": 120 },
        "accountNumber": { "type": "string", "minLength": 4, "maxLength": 64 },
        "iban": { "type": "string", "minLength": 8, "maxLength": 64 },
        "jazzcashNumber": { "type": "string", "maxLength": 40 },
        "instructions": { "type": "string", "minLength": 5, "maxLength": 1000 },
        "instructionsUr": { "type": "string", "minLength": 2, "maxLength": 1000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["bankName", "accountTitle", "accountNumber", "iban", "jazzcashNumber", "instructions", "instructionsUr", "updatedAt"]
    },
    "CommissionSettings": {
      "title": "CommissionSettings",
      "description": "Admin-configurable agency commission rates",
      "type": "object",
      "properties": {
        "defaultCommissionPercent": { "type": "number" },
        "socialMediaPercent": { "type": "number" },
        "videoEditingPercent": { "type": "number" },
        "logoBrandingPercent": { "type": "number" },
        "webDevPercent": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["defaultCommissionPercent", "socialMediaPercent", "videoEditingPercent", "logoBrandingPercent", "webDevPercent", "updatedAt"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Trusted admin UID registry",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "addedAt"]
    }
  },
  "firestore": {
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Admin authorization registry"
    },
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Private user account profiles"
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/Service" },
      "description": "Agency service catalogue and pricing in PKR"
    },
    "/freelancers/{uid}": {
      "schema": { "$ref": "#/entities/FreelancerProfile" },
      "description": "Approved freelancer public-safe portfolio and skills"
    },
    "/freelancers/{uid}/private/payout": {
      "schema": { "$ref": "#/entities/FreelancerPayout" },
      "description": "Isolated freelancer bank payout details"
    },
    "/freelancerApplications/{uid}": {
      "schema": { "$ref": "#/entities/FreelancerApplication" },
      "description": "Freelancer registration applications with bank and contact PII"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer service orders, payment verification state, and fulfillment"
    },
    "/orders/{orderId}/files/{fileId}": {
      "schema": { "$ref": "#/entities/OrderFile" },
      "description": "Private project brief and deliverable file records"
    },
    "/orders/{orderId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/OrderTask" },
      "description": "Project tasks managed by assigned freelancer and admin"
    },
    "/orders/{orderId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/OrderMessage" },
      "description": "Order collaboration thread"
    },
    "/assignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/Assignment" },
      "description": "Freelancer assignment and commission/earnings ledger"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Verified customer work-approval reviews"
    },
    "/settings/payment": {
      "schema": { "$ref": "#/entities/PaymentSettings" },
      "description": "Manual bank transfer instructions displayed to customers"
    },
    "/settings/commission": {
      "schema": { "$ref": "#/entities/CommissionSettings" },
      "description": "Customizable agency commission percentages"
    }
  }
}
